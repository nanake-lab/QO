{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "skipLibCheck": false
  },
  "include": [
    "tests/**/*.ts",
    "packages/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/src/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
