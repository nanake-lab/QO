{
  "productName": "QO",
  "version": "0.1.0",
  "identifier": "io.github.nanake-lab.qo",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QO",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
