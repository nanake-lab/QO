{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QO v1",
  "description": "Select a named wire schema by its #/definitions/ pointer. methods.json indexes RPC parameters, results and notification payloads.",
  "definitions": {
    "Id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "OwnerKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ProtocolVersion": {
      "type": "string",
      "enum": ["qo.v1"]
    },
    "Creator": {
      "type": "string",
      "enum": ["ui", "external"]
    },
    "CancelledBy": {
      "type": "string",
      "enum": ["owner", "ui"]
    },
    "TaskState": {
      "type": "string",
      "enum": ["open", "closed"]
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "starting",
        "idle",
        "running",
        "waiting_input",
        "waiting_approval",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "TurnState": {
      "type": "string",
      "enum": ["running", "completed", "interrupted", "failed"]
    },
    "ItemState": {
      "type": "string",
      "enum": ["running", "completed", "failed", "interrupted"]
    },
    "ApprovalState": {
      "type": "string",
      "enum": ["pending", "decided", "expired", "withdrawn"]
    },
    "ApprovalKind": {
      "type": "string",
      "enum": ["command_execution", "file_change", "permissions", "elicitation"]
    },
    "Choice": {
      "type": "string",
      "enum": ["allow_once", "deny"]
    },
    "Delivery": {
      "type": "string",
      "enum": ["recorded", "sent", "unknown"]
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "forbiddenRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdBy": {
          "$ref": "#/definitions/Creator"
        },
        "state": {
          "$ref": "#/definitions/TaskState"
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "closedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "taskId",
        "name",
        "cwd",
        "forbiddenRoots",
        "createdBy",
        "state",
        "createdAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "closed"
              }
            },
            "required": ["state"]
          },
          "then": {
            "required": ["closedAt"]
          },
          "else": {
            "not": {
              "required": ["closedAt"]
            }
          }
        }
      ]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        },
        "serviceTier": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/SessionState"
        },
        "error": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "cancelledBy": {
          "$ref": "#/definitions/CancelledBy"
        },
        "endedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": ["sessionId", "taskId", "harness", "state", "createdAt"],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "cancelled"
              }
            },
            "required": ["state"]
          },
          "then": {
            "required": ["cancelledBy"]
          },
          "else": {
            "not": {
              "required": ["cancelledBy"]
            }
          }
        }
      ]
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turnId": {
          "$ref": "#/definitions/Id"
        },
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "input": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/TurnState"
        },
        "startedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "endedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": ["turnId", "sessionId", "input", "state", "startedAt"]
    },
    "CommandContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string"
        },
        "exitCode": {
          "type": "integer"
        }
      },
      "required": ["command", "output"]
    },
    "FileContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "diff": {
          "type": "string"
        }
      },
      "required": ["path", "diff"]
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "$ref": "#/definitions/Id"
        },
        "turnId": {
          "$ref": "#/definitions/Id"
        },
        "state": {
          "$ref": "#/definitions/ItemState"
        },
        "startedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "endedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "kind": {
          "type": "string"
        },
        "content": {}
      },
      "required": ["itemId", "turnId", "state", "startedAt", "kind", "content"],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "assistant_message"
            },
            "content": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "command_execution"
            },
            "content": {
              "$ref": "#/definitions/CommandContent"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "file_change"
            },
            "content": {
              "$ref": "#/definitions/FileContent"
            }
          }
        }
      ]
    },
    "RawRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["method", "params"]
    },
    "ApprovalRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvalId": {
          "$ref": "#/definitions/Id"
        },
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "turnId": {
          "$ref": "#/definitions/Id"
        },
        "itemId": {
          "$ref": "#/definitions/Id"
        },
        "kind": {
          "$ref": "#/definitions/ApprovalKind"
        },
        "raw": {
          "$ref": "#/definitions/RawRequest"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "expiresAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "state": {
          "$ref": "#/definitions/ApprovalState"
        }
      },
      "required": [
        "approvalId",
        "taskId",
        "sessionId",
        "kind",
        "raw",
        "summary",
        "digest",
        "expiresAt",
        "state"
      ]
    },
    "ApprovalDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisionId": {
          "$ref": "#/definitions/Id"
        },
        "approvalId": {
          "$ref": "#/definitions/Id"
        },
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "choice": {
          "$ref": "#/definitions/Choice"
        },
        "answer": {
          "type": "object",
          "additionalProperties": true
        },
        "decidedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "delivery": {
          "$ref": "#/definitions/Delivery"
        }
      },
      "required": [
        "decisionId",
        "approvalId",
        "digest",
        "choice",
        "decidedAt",
        "delivery"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "choice": {
                "const": "deny"
              }
            },
            "required": ["choice"]
          },
          "then": {
            "not": {
              "required": ["answer"]
            }
          }
        }
      ]
    },
    "UsageCount": {
      "type": ["string", "null"],
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "UsageCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totalTokens": {
          "$ref": "#/definitions/UsageCount"
        },
        "inputTokens": {
          "$ref": "#/definitions/UsageCount"
        },
        "cachedInputTokens": {
          "$ref": "#/definitions/UsageCount"
        },
        "outputTokens": {
          "$ref": "#/definitions/UsageCount"
        },
        "reasoningOutputTokens": {
          "$ref": "#/definitions/UsageCount"
        },
        "cacheWriteInputTokens": {
          "$ref": "#/definitions/UsageCount"
        }
      },
      "required": [
        "totalTokens",
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "cacheWriteInputTokens"
      ]
    },
    "Usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "turnId": {
          "$ref": "#/definitions/Id"
        },
        "model": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        },
        "serviceTier": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "counts": {
          "$ref": "#/definitions/UsageCounts"
        },
        "observedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": ["sessionId", "source", "counts", "observedAt"]
    },
    "ItemDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "$ref": "#/definitions/Id"
        },
        "delta": {
          "type": "string"
        }
      },
      "required": ["itemId", "delta"]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "at": {
          "$ref": "#/definitions/Timestamp"
        },
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "turnId": {
          "$ref": "#/definitions/Id"
        },
        "kind": {
          "type": "string"
        },
        "payload": {}
      },
      "required": ["cursor", "at", "taskId", "kind", "payload"],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "task.changed"
            },
            "payload": {
              "$ref": "#/definitions/Task"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "session.changed"
            },
            "payload": {
              "$ref": "#/definitions/Session"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "turn.changed"
            },
            "payload": {
              "$ref": "#/definitions/Turn"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "item.changed"
            },
            "payload": {
              "$ref": "#/definitions/Item"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "item.delta"
            },
            "payload": {
              "$ref": "#/definitions/ItemDelta"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "usage.updated"
            },
            "payload": {
              "$ref": "#/definitions/Usage"
            }
          }
        }
      ]
    },
    "InitializeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": ["versions"]
    },
    "InitializeResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/definitions/ProtocolVersion"
        }
      },
      "required": ["version"]
    },
    "LoginLinkParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "LoginLinkResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/#login=[0-9a-f]+$"
        }
      },
      "required": ["url"]
    },
    "TaskCreateParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "forbiddenRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownerKey": {
          "$ref": "#/definitions/OwnerKey"
        }
      },
      "required": ["taskId", "name"]
    },
    "TaskCreateResult": {
      "$ref": "#/definitions/Task"
    },
    "TaskAttachParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "ownerKey": {
          "$ref": "#/definitions/OwnerKey"
        }
      },
      "required": ["taskId", "ownerKey"]
    },
    "TaskAttachResult": {
      "$ref": "#/definitions/Task"
    },
    "TaskCloseParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": ["taskId"]
    },
    "TaskCloseResult": {
      "$ref": "#/definitions/Task"
    },
    "StateGetParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "StateGetResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Task"
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Session"
          }
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Turn"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Usage"
          }
        },
        "cursor": {
          "$ref": "#/definitions/Decimal"
        }
      },
      "required": ["tasks", "sessions", "turns", "items", "usage", "cursor"]
    },
    "SessionOpenParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string",
          "minLength": 1
        },
        "serviceTier": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["taskId"]
    },
    "SessionOpenResult": {
      "$ref": "#/definitions/Session"
    },
    "SessionFinishParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "sessionId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": ["taskId", "sessionId"]
    },
    "SessionFinishResult": {
      "$ref": "#/definitions/Session"
    },
    "SessionCancelParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "sessionId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": ["taskId", "sessionId"]
    },
    "SessionCancelResult": {
      "$ref": "#/definitions/Session"
    },
    "TurnStartParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "input": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["sessionId", "input"]
    },
    "TurnStartResult": {
      "$ref": "#/definitions/Turn"
    },
    "TurnAppendParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "turnId": {
          "$ref": "#/definitions/Id"
        },
        "input": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["sessionId", "turnId", "input"]
    },
    "TurnAppendResult": {
      "$ref": "#/definitions/Turn"
    },
    "TurnInterruptParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "turnId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": ["sessionId", "turnId"]
    },
    "TurnInterruptResult": {
      "$ref": "#/definitions/Turn"
    },
    "InputAnswerParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/definitions/Id"
        },
        "turnId": {
          "$ref": "#/definitions/Id"
        },
        "requestId": {
          "$ref": "#/definitions/Id"
        },
        "answer": {
          "type": "string"
        }
      },
      "required": ["sessionId", "turnId", "requestId", "answer"]
    },
    "InputAnswerResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ApprovalListParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": ["taskId"]
    },
    "ApprovalListResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ApprovalRequest"
          }
        }
      },
      "required": ["requests"]
    },
    "ApprovalRenewParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "approvalId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": ["taskId", "approvalId"]
    },
    "ApprovalRenewResult": {
      "$ref": "#/definitions/ApprovalRequest"
    },
    "ApprovalDecideParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "$ref": "#/definitions/Id"
        },
        "approvalId": {
          "$ref": "#/definitions/Id"
        },
        "decisionId": {
          "$ref": "#/definitions/Id"
        },
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "choice": {
          "$ref": "#/definitions/Choice"
        },
        "answer": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["taskId", "approvalId", "decisionId", "digest", "choice"],
      "allOf": [
        {
          "if": {
            "properties": {
              "choice": {
                "const": "deny"
              }
            },
            "required": ["choice"]
          },
          "then": {
            "not": {
              "required": ["answer"]
            }
          }
        }
      ]
    },
    "ApprovalDecideResult": {
      "$ref": "#/definitions/ApprovalDecision"
    },
    "UsageGetParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": ["sessionId"]
    },
    "UsageGetResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Usage"
          }
        }
      },
      "required": ["usage"]
    },
    "EventsSubscribeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "afterCursor": {
          "$ref": "#/definitions/Decimal"
        }
      },
      "required": ["afterCursor"]
    },
    "EventsSubscribeResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "InputRequested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "#/definitions/Id"
        },
